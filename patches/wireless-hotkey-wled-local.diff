+/*
+ * HP firmware drives the airplane mode LED through the HPQ6001 device's WLED
+ * method; Windows calls it when the radio state changes.
+ */
+static int wireless_led_set(struct led_classdev *led, enum led_brightness value)
+{
+	struct wl_button *button = container_of(led, struct wl_button, led);
+	acpi_status status;
+
+	status = acpi_execute_simple_method(button->adev->handle, "WLED", value ? 1 : 0);
+	return ACPI_SUCCESS(status) ? 0 : -EIO;
+}
+
+static int wireless_led_setup(struct acpi_device *device)
+{
+	struct wl_button *button = acpi_driver_data(device);
+	int err;
+
+	if (!acpi_has_method(device->handle, "WLED"))
+		return 0;
+
+	button->led.name = "platform::wlan";
+	button->led.max_brightness = 1;
+	button->led.brightness_set_blocking = wireless_led_set;
+	button->led.default_trigger = "rfkill-any";
+	err = led_classdev_register(&device->dev, &button->led);
+	if (err)
+		return err;
+	button->has_led = true;
+	return 0;
+}
+
 static void wireless_input_destroy(struct acpi_device *device)
 {
 	struct wl_button *button = acpi_driver_data(device);
 
+	if (button->has_led)
+		led_classdev_unregister(&button->led);
 	input_unregister_device(button->input_dev);
 	kfree(button);
 }
